{
  "name": "train-smarter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --names server,web --prefix-colors blue,magenta --kill-others-on-fail \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed:demo": "npm run db:seed:demo -w server",
    "db:studio": "npm run db:studio -w server",
    "job:daily": "npm run job:daily -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
