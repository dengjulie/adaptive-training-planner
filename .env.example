# Copy to .env and fill in. The API server and drizzle-kit both read this file.

PORT=8787
# Public origin of the web app. In development that's the Vite dev server, which proxies /api and
# /auth to the API server, so every OAuth redirect URI below uses this origin too.
APP_URL=http://localhost:5173

DATABASE_URL=postgresql://localhost:5432/train_smarter

# Generate each with: openssl rand -base64 32
SESSION_SECRET=
# Encrypts OAuth tokens at rest. Changing it makes stored tokens unreadable (users reconnect).
TOKEN_ENCRYPTION_KEY=

# Optional comma-separated allowlist of Google accounts that may sign in.
ALLOWED_EMAILS=

# Google Cloud OAuth client (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Oura app from https://developer.ouraring.com with every scope enabled; the app requests all of
# them, and "daily" is required.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:5173/auth/oura/callback

# Regional COROS MCP endpoint for your account: mcpus (Americas), mcpeu (Europe), mcpcn (China).
# No client ID needed: the app registers itself with COROS on first connect.
COROS_MCP_URL=https://mcpus.coros.com/mcp

# Optional: turns on the AI goal intake (a chat that fills in the goal form). It sends Anthropic
# what the user types and their COROS training volume; never Oura data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Development only: /auth/demo signs in as a synthetic demo user (see src/scripts/seed-demo.ts).
DEMO_MODE=false
