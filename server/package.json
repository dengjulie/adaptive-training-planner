{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "node --env-file-if-exists=../.env src/scripts/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "job:daily": "node --env-file-if-exists=../.env src/jobs/daily.ts"
  },
  "dependencies": {
    "@googleapis/calendar": "^20.1.0",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/client": "^2.3.1",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.2.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
